{
  "spider": "https://github.com/FongMi/Release/raw/fongmi/jar/custom_spider.jar",
  "sites": [
    {
      "key": "filmekseni",
      "name": "Film Ekseni",
      "type": 3,
      "api": "csp_Web",
      "searchable": 1,
      "quickSearch": 1,
      "filterable": 1,
      "ext": "https://filmekseni.vip/"
    }
  ],
  "rules": [
    {
      "name": "sniff_rule",
      "hosts": ["*"],
      "regex": ["http((?!http).){12,}?\\.(m3u8|mp4|flv|avi|mkv|rmvb|wmv)[^\\?]*"]
    }
  ]
}
